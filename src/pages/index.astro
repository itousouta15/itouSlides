---
import Base from "../layouts/Base.astro";
import SlideCard from "../components/SlideCard.astro";
import HomeworkCard from "../components/HomeworkCard.astro";
import data from "../data/slides.json";

const { slides, homework, author } = data;

const tagLabels: Record<string, string> = {
	security: "資訊安全",
	web: "網頁開發",
	software: "軟體開發",
	design: "設計",
	oss: "開源社群",
	AI: "人工智慧"
};

const uniqueTags = [...new Set(slides.flatMap(s => s.tags))];
const categories = [{ id: "all", label: "所有分類" }, ...uniqueTags.map(t => ({ id: t, label: tagLabels[t] ?? t }))];
const now = new Date();
const stamp = `${now.getFullYear()}.${(now.getMonth() + 1).toString().padStart(2, "0")}`;
---

<Base title="itouSlides" description="伊藤蒼太的公開簡報集，涵蓋網頁開發、軟體開發、設計與開源社群。">
	<div class="page-wrap">
		<header class="site-header">
			<div class="header-meta mono">
				<span class="meta-brand">ITOUSLIDES</span>
				<span class="sep">/</span>
				<span>{stamp}</span>
				<span class="sep">/</span>
				<span>CC BY 4.0</span>
				<div class="header-actions">
					<button class="hw-login-btn" id="hw-unlock-btn">登入</button>
					<button class="theme-toggle" id="theme-toggle" aria-label="切換深淺色模式" title="切換深淺色模式">
						<span id="theme-icon">☀</span>
					</button>
				</div>
			</div>

			<div class="title-block">
				<span class="title-label mono">Public Slides</span>
				<h1 class="serif">itouSlides</h1>
				<p class="title-hand">知識就是要拿來分享的 ( ˘ω˘ )</p>
			</div>

			<p class="header-desc">
				簡報均採用創用 CC「<a href="https://creativecommons.org/licenses/by/4.0/deed.zh-hant" target="_blank" rel="noopener">姓名標示 4.0 國際</a>」授權。部分會重複使用於不同課程，持續更新。
			</p>
		</header>

		<main class="main-content">
			<section class="sec">
				<div class="sec-head">
					<span class="sec-index mono">01</span>
					<div class="sec-titles">
						<span class="sec-label mono">Slides · <span id="stat-total">{slides.length}</span></span>
						<h2 class="sec-title serif">簡報</h2>
					</div>
				</div>

				<nav class="filter-bar" aria-label="分類篩選">
					<div class="filter-btns" role="tablist">
						{
							categories.map((cat, i) => (
								<button class={`filter-btn${i === 0 ? " active" : ""}`} data-category={cat.id} role="tab" aria-selected={i === 0 ? "true" : "false"}>
									{cat.label}
								</button>
							))
						}
					</div>
				</nav>

				<div class="slides-grid" id="slides-grid">
					{slides.map((slide, i) => <SlideCard slide={{ ...slide, hosted: (slide as any).hosted ?? false }} index={i} />)}
				</div>

				<p class="no-results hidden" id="no-results">此分類目前沒有簡報。</p>
			</section>
		</main>

		<section class="sec hw-section hidden" id="hw-section">
			<div class="sec-head">
				<span class="sec-index mono">02</span>
				<div class="sec-titles">
					<span class="sec-label mono">Homework</span>
					<h2 class="sec-title serif">學校</h2>
				</div>
				<button class="hw-logout-btn" id="hw-logout-btn">登出</button>
			</div>
			<div class="hw-grid">
				{homework.map((hw, i) => <HomeworkCard hw={hw} index={i} />)}
			</div>
		</section>

		<!-- Password Modal -->
		<div class="modal-backdrop hidden" id="modal-backdrop" role="dialog" aria-modal="true" aria-label="輸入密碼">
			<div class="modal">
				<div class="modal-header">
					<span class="modal-title serif">登入</span>
					<button class="modal-close" id="modal-close" aria-label="關閉">✕</button>
				</div>
				<div class="modal-body">
					<label for="pw-input" class="pw-label mono">Password</label>
					<input type="password" id="pw-input" class="pw-input" placeholder="輸入密碼…" autocomplete="current-password" />
					<p class="pw-error hidden" id="pw-error">密碼錯誤，請再試一次。</p>
				</div>
				<div class="modal-footer">
					<button class="pw-submit" id="pw-submit">確認</button>
				</div>
			</div>
		</div>

		<footer class="site-footer">
			<div class="footer-content">
				<span class="mono footer-copy">© {now.getFullYear()} <a href={author.url}>{author.fullName}</a> ฅ^•ﻌ•^ฅ</span>
				<nav class="footer-links mono" aria-label="相關連結">
					<a href="https://links.itousouta15.tw" target="_blank" rel="noopener">itouLinks</a>
					<span aria-hidden="true">/</span>
					<a href="https://cards.itousouta15.tw/" target="_blank" rel="noopener">itouCards</a>
					<span aria-hidden="true">/</span>
					<a href="https://blog.itousouta15.tw/" target="_blank" rel="noopener">itouBLoGa</a>
					<span aria-hidden="true">/</span>
					<a href="https://github.com/itousouta15/itouSlides" target="_blank" rel="noopener">GitHub</a>
				</nav>
			</div>
		</footer>
	</div>
</Base>

<script>
	// Filter
	const filterBtns = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
	const cards = document.querySelectorAll<HTMLElement>(".slide-card");
	const noResults = document.getElementById("no-results")!;
	const statTotal = document.getElementById("stat-total")!;

	filterBtns.forEach(btn => {
		btn.addEventListener("click", () => {
			filterBtns.forEach(b => {
				b.classList.remove("active");
				b.setAttribute("aria-selected", "false");
			});
			btn.classList.add("active");
			btn.setAttribute("aria-selected", "true");

			const cat = btn.dataset.category!;
			let visible = 0;

			cards.forEach(card => {
				const tags = card.dataset.tags?.split(",") ?? [];
				const show = cat === "all" || tags.includes(cat);
				(card as HTMLElement).style.display = show ? "" : "none";
				if (show) visible++;
			});

			statTotal.textContent = String(visible);
			noResults.classList.toggle("hidden", visible > 0);
		});
	});

	// Homework lock
	const HW_KEY = "hw_unlocked";
	const HW_PW = "Zxc19201080@";

	const hwSection = document.getElementById("hw-section")!;
	const hwUnlockBtn = document.getElementById("hw-unlock-btn")!;
	const hwLogoutBtn = document.getElementById("hw-logout-btn")!;
	const backdrop = document.getElementById("modal-backdrop")!;
	const modalClose = document.getElementById("modal-close")!;
	const pwInput = document.getElementById("pw-input") as HTMLInputElement;
	const pwSubmit = document.getElementById("pw-submit")!;
	const pwError = document.getElementById("pw-error")!;

	function unlockHw() {
		hwSection.classList.remove("hidden");
		hwUnlockBtn.classList.add("hidden");
		sessionStorage.setItem(HW_KEY, "1");
	}

	function lockHw() {
		hwSection.classList.add("hidden");
		hwUnlockBtn.classList.remove("hidden");
		sessionStorage.removeItem(HW_KEY);
	}

	function openModal() {
		backdrop.classList.remove("hidden");
		pwInput.value = "";
		pwError.classList.add("hidden");
		setTimeout(() => pwInput.focus(), 50);
	}

	function closeModal() {
		backdrop.classList.add("hidden");
	}

	function tryUnlock() {
		if (pwInput.value === HW_PW) {
			unlockHw();
			closeModal();
		} else {
			pwError.classList.remove("hidden");
			pwInput.select();
		}
	}

	if (sessionStorage.getItem(HW_KEY) === "1") unlockHw();

	hwUnlockBtn.addEventListener("click", openModal);
	hwLogoutBtn.addEventListener("click", lockHw);
	modalClose.addEventListener("click", closeModal);
	backdrop.addEventListener("click", e => {
		if (e.target === backdrop) closeModal();
	});
	pwSubmit.addEventListener("click", tryUnlock);
	pwInput.addEventListener("keydown", e => {
		if (e.key === "Enter") tryUnlock();
	});

	// Theme toggle — dark is default, light is the opt-in attribute
	const toggle = document.getElementById("theme-toggle")!;
	const icon = document.getElementById("theme-icon")!;

	function updateIcon() {
		const isLight = document.documentElement.getAttribute("data-theme") === "light";
		icon.textContent = isLight ? "☾" : "☀";
	}

	toggle.addEventListener("click", () => {
		const isLight = document.documentElement.getAttribute("data-theme") === "light";
		if (isLight) {
			document.documentElement.removeAttribute("data-theme");
			localStorage.setItem("theme", "dark");
		} else {
			document.documentElement.setAttribute("data-theme", "light");
			localStorage.setItem("theme", "light");
		}
		updateIcon();
	});

	updateIcon();
</script>

<style>
	.page-wrap {
		max-width: 1080px;
		margin: 0 auto;
		padding: 2rem 1.5rem 4rem;
	}

	@keyframes itFade {
		0% {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	/* ─── Header ─── */
	.site-header {
		padding: 2.5rem 0 2rem;
		margin-bottom: 1.5rem;
		animation: itFade 0.5s ease both;
	}

	.header-meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--mute);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		margin-bottom: 2.5rem;
	}

	.header-meta .sep {
		opacity: 0.5;
	}

	.meta-brand {
		color: var(--blue);
		font-weight: 700;
		letter-spacing: 0.16em;
	}

	.header-actions {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.hw-login-btn {
		font-family: var(--font-sans);
		font-size: 0.82rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--tx);
		padding: 0.45rem 1.1rem;
		border: 1px solid var(--bd2);
		border-radius: 999px;
		background: transparent;
		transition:
			border-color 0.2s ease,
			background 0.2s ease,
			color 0.2s ease;
		line-height: 1;
	}

	.hw-login-btn:hover {
		background: var(--btn);
		border-color: var(--btn);
		color: var(--btntx);
	}

	.theme-toggle {
		width: 34px;
		height: 34px;
		border-radius: 50%;
		border: 1px solid var(--bd2);
		background: var(--inset);
		color: var(--tx);
		font-size: 0.9rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition:
			transform 0.15s ease,
			border-color 0.2s ease;
		line-height: 1;
	}

	.theme-toggle:hover {
		transform: rotate(20deg);
		border-color: var(--mute);
	}

	/* ─── Title ─── */
	.title-block {
		margin-bottom: 1.25rem;
	}

	.title-label {
		display: block;
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--mute);
		margin-bottom: 0.4rem;
	}

	h1 {
		font-size: clamp(2.2rem, 5vw, 3.25rem);
		font-weight: 700;
		letter-spacing: 0.01em;
		line-height: 1.15;
		color: var(--tx);
	}

	.title-hand {
		font-family: var(--font-hand);
		font-size: 1.35rem;
		color: var(--dim);
		margin-top: 0.5rem;
	}

	/* ─── Description ─── */
	.header-desc {
		font-size: 0.9rem;
		color: var(--dim);
		line-height: 1.8;
		max-width: 42rem;
	}

	.header-desc a {
		color: var(--blue);
		border-bottom: 1px solid transparent;
		transition: border-color 0.2s ease;
	}

	.header-desc a:hover {
		border-color: var(--blue);
	}

	/* ─── Sections ─── */
	.sec {
		animation: itFade 0.5s ease 0.1s both;
	}

	.sec-head {
		display: flex;
		align-items: flex-end;
		gap: 1rem;
		margin-bottom: 1.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--bd);
	}

	.sec-index {
		font-size: 0.8rem;
		font-weight: 500;
		color: var(--mute);
		line-height: 2.4;
	}

	.sec-titles {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
	}

	.sec-label {
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--mute);
	}

	.sec-title {
		font-size: 1.7rem;
		font-weight: 700;
		color: var(--tx);
		line-height: 1.2;
	}

	/* ─── Filter bar ─── */
	.filter-bar {
		margin-bottom: 1.75rem;
	}

	.filter-btns {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.filter-btn {
		font-size: 0.8rem;
		font-weight: 500;
		padding: 0.4rem 1rem;
		border-radius: 999px;
		border: 1px solid var(--bd2);
		color: var(--dim);
		background: transparent;
		letter-spacing: 0.04em;
		transition:
			border-color 0.2s ease,
			color 0.2s ease,
			background 0.2s ease;
	}

	.filter-btn:hover {
		color: var(--tx);
		border-color: var(--mute);
	}

	.filter-btn.active {
		background: var(--btn);
		border-color: var(--btn);
		color: var(--btntx);
	}

	/* ─── Cards grid ─── */
	.slides-grid,
	.hw-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
		gap: 1rem;
	}

	.no-results {
		text-align: center;
		color: var(--mute);
		padding: 3rem 0;
		font-size: 0.9rem;
	}

	.hidden {
		display: none !important;
	}

	/* ─── Homework Section ─── */
	.hw-section {
		margin-top: 3rem;
	}

	.hw-section .sec-head {
		align-items: flex-end;
	}

	.hw-logout-btn {
		margin-left: auto;
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--dim);
		padding: 0.4rem 1rem;
		border: 1px solid var(--bd2);
		border-radius: 999px;
		background: transparent;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.hw-logout-btn:hover {
		color: var(--tx);
		border-color: var(--mute);
	}

	/* ─── Password Modal ─── */
	.modal-backdrop {
		position: fixed;
		inset: 0;
		background: #0000008c;
		backdrop-filter: blur(6px);
		z-index: 400;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 1rem;
	}

	@keyframes modal-pop {
		0% {
			opacity: 0;
			transform: translateY(16px) scale(0.97);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.modal {
		background: var(--panel);
		border: 1px solid var(--bd2);
		width: 100%;
		max-width: 400px;
		box-shadow: 0 30px 60px var(--shadow);
		overflow: hidden;
		animation: modal-pop 0.22s cubic-bezier(0.16, 1, 0.3, 1) both;
	}

	.modal-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1rem 1.25rem;
		border-bottom: 1px solid var(--bd);
	}

	.modal-title {
		font-size: 1.1rem;
		font-weight: 700;
		color: var(--tx);
	}

	.modal-close {
		width: 30px;
		height: 30px;
		border-radius: 50%;
		border: 1px solid var(--bd2);
		background: var(--inset);
		color: var(--tx);
		font-size: 0.75rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition:
			transform 0.15s ease,
			border-color 0.2s ease;
	}

	.modal-close:hover {
		transform: rotate(90deg);
		border-color: var(--mute);
	}

	.modal-body {
		padding: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.pw-label {
		font-size: 0.7rem;
		font-weight: 500;
		color: var(--mute);
		letter-spacing: 0.16em;
		text-transform: uppercase;
	}

	.pw-input {
		width: 100%;
		padding: 0.6rem 0.9rem;
		border: 1px solid var(--bd2);
		border-radius: 2px;
		background: var(--inset);
		color: var(--tx);
		font-size: 0.95rem;
		font-family: var(--font-mono);
		outline: none;
		transition: border-color 0.2s ease;
	}

	.pw-input:focus {
		border-color: var(--blue);
	}

	.pw-error {
		font-size: 0.8rem;
		color: #e07070;
		font-weight: 500;
	}

	.modal-footer {
		padding: 0.75rem 1.25rem 1.25rem;
	}

	.pw-submit {
		width: 100%;
		padding: 0.65rem;
		font-size: 0.9rem;
		font-weight: 700;
		letter-spacing: 0.04em;
		color: var(--btntx);
		background: var(--btn);
		border-radius: 999px;
		transition:
			opacity 0.2s ease,
			transform 0.15s ease;
	}

	.pw-submit:hover {
		opacity: 0.9;
		transform: translateY(-1px);
	}

	/* ─── Footer ─── */
	.site-footer {
		margin-top: 4rem;
		border-top: 1px solid var(--bd);
		padding-top: 1.5rem;
	}

	.footer-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.75rem;
		font-size: 0.75rem;
		letter-spacing: 0.04em;
		color: var(--mute);
	}

	.footer-copy a {
		color: var(--dim);
		border-bottom: 1px solid transparent;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.footer-links a {
		color: var(--dim);
		border-bottom: 1px solid transparent;
		transition:
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.footer-copy a:hover,
	.footer-links a:hover {
		color: var(--blue);
		border-color: var(--blue);
	}

	.footer-links {
		display: flex;
		gap: 0.6rem;
		align-items: center;
	}

	.footer-links span {
		opacity: 0.5;
	}

	/* ─── Responsive ─── */
	@media (max-width: 640px) {
		.slides-grid,
		.hw-grid {
			grid-template-columns: 1fr;
		}
		.header-meta {
			flex-wrap: wrap;
		}
		.footer-content {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
