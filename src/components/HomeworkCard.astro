---
export interface HomeworkData {
	title: string;
	subject: string;
	description: string;
	year: number;
	url: string;
}

interface Props {
	hw: HomeworkData;
	index: number;
}

const { hw, index } = Astro.props;
const isExternal = hw.url.startsWith("http");
---

<article class="hw-card" style={`animation-delay: ${index * 60}ms`}>
	<header class="hw-header">
		<span class="hw-index mono">{String(index + 1).padStart(2, "0")}</span>
		<span class="hw-subject mono">{hw.subject}</span>
	</header>

	<div class="hw-body">
		<h3 class="hw-title serif">{hw.title}</h3>
		<p class="hw-desc">{hw.description}</p>
	</div>

	<footer class="hw-footer">
		<span class="hw-year mono">{hw.year}</span>
		<a
			href={hw.url !== "#" ? hw.url : undefined}
			class={`hw-link${hw.url === "#" ? " hw-link-disabled" : ""}`}
			target={hw.url !== "#" ? "_blank" : undefined}
			rel={isExternal ? "noopener" : undefined}
		>
			開啟檔案
			<span class="link-arrow" aria-hidden="true">→</span>
		</a>
	</footer>
</article>

<style>
	.hw-card {
		background: var(--panel);
		border: 1px solid var(--bd);
		border-radius: 0;
		padding: 1.4rem 1.5rem;
		box-shadow: none;
		transition: border-color 0.25s ease;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		opacity: 0;
		animation: itFade 0.4s ease forwards;
	}

	@keyframes itFade {
		0% {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.hw-card:hover {
		border-color: var(--bd2);
	}

	.hw-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.hw-index {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--mute);
		letter-spacing: 0.08em;
	}

	.hw-subject {
		font-size: 0.66rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		padding: 0.2rem 0.6rem;
		border-radius: 2px;
		border: 1px solid var(--bd2);
		color: var(--purple);
		background: transparent;
	}

	.hw-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.hw-title {
		font-size: 1.15rem;
		font-weight: 700;
		line-height: 1.35;
		color: var(--tx);
	}

	.hw-desc {
		font-size: 0.86rem;
		color: var(--dim);
		line-height: 1.8;
		margin-top: 0.25rem;
	}

	.hw-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-top: 1px solid var(--bd);
		padding-top: 0.85rem;
		margin-top: auto;
	}

	.hw-year {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--mute);
		letter-spacing: 0.08em;
	}

	.hw-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.82rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--tx);
	}

	.link-arrow {
		width: 26px;
		height: 26px;
		border-radius: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.85rem;
		background: var(--inset);
		border: 1px solid var(--bd2);
		color: var(--purple);
		transform: rotate(-45deg);
		transition:
			transform 0.2s ease,
			background 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.hw-link:hover .link-arrow {
		background: var(--btn);
		border-color: var(--btn);
		color: var(--btntx);
		transform: rotate(0deg);
	}

	.hw-link-disabled {
		opacity: 0.35;
		cursor: not-allowed;
		pointer-events: none;
	}
</style>
