---
export interface SlideData {
	title: string;
	subtitle: string | null;
	description: string;
	tags: string[];
	year: number;
	hosted: boolean;
	url: string;
}

interface Props {
	slide: SlideData;
	index: number;
}

const { slide, index } = Astro.props;
const { url } = slide;

function getLinkType(url: string): "hosted" | "drive" | "sitcon" | "github" | "external" {
	if (url.startsWith("/talks/")) return "hosted";
	if (url.includes("drive.google.com")) return "drive";
	if (url.includes("sitcon.org")) return "sitcon";
	if (url.includes("github.com")) return "github";
	return "external";
}

const linkType = getLinkType(url);
const isExternal = linkType !== "hosted";

const linkLabels: Record<string, string> = {
	hosted: "開啟簡報",
	drive: "Google Drive",
	sitcon: "SITCON 議程",
	github: "GitHub",
	external: "前往查看"
};
const linkLabel = linkLabels[linkType];

const tagLabels: Record<string, string> = {
	security: "資訊安全",
	web: "網頁開發",
	software: "軟體開發",
	design: "設計",
	oss: "開源社群",
	AI: "人工智慧"
};
---

<article class="slide-card" data-tags={slide.tags.join(",")} style={`animation-delay: ${index * 60}ms`}>
	<header class="card-header">
		<span class="card-index mono">{String(index + 1).padStart(2, "0")}</span>
		<div class="card-tags">
			{slide.tags.map((tag: string) => <span class={`card-tag mono tag-${tag}`}>{tagLabels[tag] ?? tag}</span>)}
		</div>
	</header>

	<div class="card-body">
		<h3 class="card-title serif">{slide.title}</h3>
		{slide.subtitle && <p class="card-subtitle">{slide.subtitle}</p>}
		<p class="card-description">{slide.description}</p>
	</div>

	<footer class="card-footer">
		<span class="card-year mono">{slide.year}</span>
		<a href={url} class="card-link" target="_blank" rel={isExternal ? "noopener" : undefined}>
			{linkLabel}
			<span class="link-arrow" aria-hidden="true">→</span>
		</a>
	</footer>
</article>

<style>
	.slide-card {
		background: var(--panel);
		border: 1px solid var(--bd);
		border-radius: 0;
		padding: 1.4rem 1.5rem;
		box-shadow: none;
		transition: border-color 0.25s ease;
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
		opacity: 0;
		animation: itFade 0.4s ease forwards;
	}

	@keyframes itFade {
		0% {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: none;
		}
	}

	.slide-card:hover {
		border-color: var(--bd2);
	}

	/* ─── Header ─── */
	.card-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
	}

	.card-index {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--mute);
		letter-spacing: 0.08em;
		flex-shrink: 0;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
		justify-content: flex-end;
	}

	.card-tag {
		font-size: 0.66rem;
		font-weight: 500;
		letter-spacing: 0.08em;
		padding: 0.2rem 0.6rem;
		border-radius: 2px;
		border: 1px solid var(--bd2);
		color: var(--dim);
		background: transparent;
		text-transform: uppercase;
	}

	/* Tag tints — dark mode (default): pastel text + translucent border */
	.tag-security {
		border-color: #d9c87a44;
		color: #d9c87a;
	}
	.tag-web {
		border-color: #93c9a444;
		color: #93c9a4;
	}
	.tag-software {
		border-color: #b0bdf744;
		color: #b0bdf7;
	}
	.tag-design {
		border-color: #dba98244;
		color: #dba982;
	}
	.tag-oss {
		border-color: #a1ade044;
		color: #a1ade0;
	}
	.tag-AI {
		border-color: #8ccdd844;
		color: #8ccdd8;
	}

	/* Tag tints — light mode: deep desaturated text */
	:global([data-theme="light"]) .tag-security {
		border-color: #8a763555;
		color: #71601f;
	}
	:global([data-theme="light"]) .tag-web {
		border-color: #3a614655;
		color: #3a6146;
	}
	:global([data-theme="light"]) .tag-software {
		border-color: #364a7c55;
		color: #364a7c;
	}
	:global([data-theme="light"]) .tag-design {
		border-color: #7a452055;
		color: #7a4520;
	}
	:global([data-theme="light"]) .tag-oss {
		border-color: #5c7cbf66;
		color: #4d5da0;
	}
	:global([data-theme="light"]) .tag-AI {
		border-color: #1a5a6b55;
		color: #1a5a6b;
	}

	/* ─── Body ─── */
	.card-body {
		flex: 1;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.card-title {
		font-size: 1.2rem;
		font-weight: 700;
		line-height: 1.35;
		color: var(--tx);
	}

	.card-subtitle {
		font-size: 0.8rem;
		color: var(--mute);
	}

	.card-description {
		font-size: 0.86rem;
		color: var(--dim);
		line-height: 1.8;
		margin-top: 0.25rem;
	}

	/* ─── Footer ─── */
	.card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		border-top: 1px solid var(--bd);
		padding-top: 0.85rem;
		margin-top: auto;
	}

	.card-year {
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--mute);
		letter-spacing: 0.08em;
	}

	.card-link {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-size: 0.82rem;
		font-weight: 500;
		letter-spacing: 0.04em;
		color: var(--tx);
	}

	.link-arrow {
		width: 26px;
		height: 26px;
		border-radius: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		font-size: 0.85rem;
		background: var(--inset);
		border: 1px solid var(--bd2);
		color: var(--blue);
		transform: rotate(-45deg);
		transition:
			transform 0.2s ease,
			background 0.2s ease,
			color 0.2s ease,
			border-color 0.2s ease;
	}

	.card-link:hover .link-arrow {
		background: var(--btn);
		border-color: var(--btn);
		color: var(--btntx);
		transform: rotate(0deg);
	}
</style>
