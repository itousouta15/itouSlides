---
interface Props {
	title?: string;
	description?: string;
}

const { title = "itouSlides", description = "伊藤蒼太的公開簡報集，涵蓋網頁開發、軟體開發、設計與開源社群。" } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="zh-Hant-TW">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="icon" type="image/x-icon" href={`${base}favicon.ico`} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=JetBrains+Mono:wght@400;500;700&family=Noto+Sans+TC:wght@300;400;500;700;900&family=Noto+Serif+TC:wght@400;600;700;900&family=Shippori+Mincho:wght@500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<link rel="stylesheet" href="https://font.emtech.cc/css/ChenYuLuoYan" />
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-9R5PZG2VQG"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());
			gtag("config", "G-9R5PZG2VQG");
			// Dark is the default theme; apply light before paint to avoid flash
			const saved = localStorage.getItem("theme");
			if (saved === "light" || (!saved && window.matchMedia("(prefers-color-scheme: light)").matches)) {
				document.documentElement.setAttribute("data-theme", "light");
			}
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	/* Design tokens mirrored from itousouta15.tw — dark first */
	:root {
		--bg: #1b1e23;
		--panel: #24262b;
		--panel2: #27292e;
		--inset: #181b20;
		--bd: #ffffff12;
		--bd2: #ffffff24;
		--tx: #e8ebf2;
		--dim: #9aa1ad;
		--mute: #6a7280;
		--blue: #b0bdf7;
		--purple: #a1ade0;
		--btn: #94a6cc;
		--btntx: #21252b;
		--shadow: #00000073;
		--font-sans: "Noto Sans TC", system-ui, sans-serif;
		--font-serif: "Shippori Mincho", "Noto Serif TC", serif;
		--font-mono: "JetBrains Mono", monospace;
		--font-hand: "ChenYuLuoYan", "Dancing Script", cursive;
	}

	[data-theme="light"]:root {
		--bg: #c2c3ca;
		--panel: #d5d6dd;
		--panel2: #d5d6dd;
		--inset: #d2d5db;
		--bd: #06060714;
		--bd2: #14182829;
		--tx: #22262d;
		--dim: #494f59;
		--mute: #6b7280;
		--blue: #364a7c;
		--purple: #5c7cbf;
		--btn: #2b2f36;
		--btntx: #f2f4f9;
		--shadow: #3c465a29;
	}

	*,
	*::before,
	*::after {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html {
		font-size: 16px;
		scroll-behavior: smooth;
	}

	body {
		font-family: var(--font-sans);
		background-color: var(--bg);
		color: var(--tx);
		min-height: 100vh;
		-webkit-font-smoothing: antialiased;
		text-size-adjust: 100%;
	}

	::selection {
		background: var(--btn);
		color: var(--btntx);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	button {
		font-family: inherit;
		cursor: pointer;
		border: none;
		background: none;
	}

	.mono {
		font-family: var(--font-mono);
	}

	.serif {
		font-family: var(--font-serif);
	}

	::-webkit-scrollbar {
		width: 8px;
		height: 8px;
		background-color: var(--inset);
	}

	::-webkit-scrollbar-thumb {
		border-radius: 999px;
		background-color: var(--mute);
	}
</style>
