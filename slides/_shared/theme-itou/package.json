{
	"name": "slidev-theme-itou",
	"private": true,
	"description": "itouSlides shared Apple-inspired Slidev theme",
	"slidev": {
		"colorSchema": "both",
		"highlighter": "shiki",
		"defaults": {
			"transition": "apple-forward | apple-back",
			"clickAnimation": "up",
			"magicMoveDuration": 480,
			"magicMoveCopy": "final",
			"mdc": true,
			"fonts": {
				"provider": "none",
				"sans": "system-ui",
				"serif": "system-ui",
				"mono": "SFMono-Regular"
			},
			"htmlAttrs": {
				"lang": "zh-Hant-TW"
			},
			"seoMeta": {
				"ogImage": "auto"
			},
			"defaults": {
				"layout": "intro"
			},
			"selectable": true
		}
	}
}
